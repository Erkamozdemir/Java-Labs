# Simple SQ program to test the STORE and LOAD operations 
# First prints 1 3 8 then it reverses the numbers and prints 8 3 1

PRINTTEXT Numbers:

# push 1, 3 and 8 into stack
PUSH 1
PUSH 3
PUSH 8
# stack: [1 3 8]
# queue: []

# print 8 and move it into queue
PRINT 
STORE
POP
# prints 8
# stack: [1 3]
# queue: [8]

# print 3 and move it into queue
PRINT
STORE
POP
# prints 3
# stack: [1]
# queue: [3 8]

# print 1 and move it into queue
PRINT
STORE
POP
# prints 1
# stack: []
# queue: [1 3 8]

PRINTTEXT
PRINTTEXT Reversed:

# Load the values back into stack
LOAD
LOAD
LOAD
# stack: [8 3 1]

# print the values on the stack 1 3 8
PRINT
POP
PRINT
POP
PRINT
POP